{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clipbridge.local/schemas/shipment.schema.json",
  "title": "ClipBridge Gateway shipment v1",
  "description": "Encrypted wire format stored and routed by the Gateway. The payload is decrypted by clients into event.schema.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "event_id",
    "kind",
    "channel_id",
    "source_device_id",
    "target_device_ids",
    "sequence",
    "created_at",
    "expires_at",
    "content_hash",
    "sensitive",
    "payload_ciphertext",
    "nonce",
    "key_id"
  ],
  "properties": {
    "version": {"const": 1},
    "event_id": {"type": "string", "minLength": 8, "maxLength": 128},
    "kind": {"enum": ["clipboard", "file", "control"]},
    "channel_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "source_device_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "target_device_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 128}
    },
    "sequence": {"type": "integer", "minimum": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "sensitive": {"type": "boolean"},
    "payload_ciphertext": {"type": "string", "minLength": 1},
    "nonce": {"type": "string", "minLength": 1, "maxLength": 64},
    "key_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "auth": {"$ref": "#/$defs/auth"}
  },
  "$defs": {
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alg", "key_id", "signature"],
      "properties": {
        "alg": {"const": "Ed25519"},
        "key_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "signature": {"type": "string", "minLength": 1}
      }
    }
  },
  "$comment": "Semantic constraints not expressible here: source_device_id must not appear in target_device_ids; expires_at must be later than created_at; nonce must be a fresh 12-byte value for AES-256-GCM."
}
