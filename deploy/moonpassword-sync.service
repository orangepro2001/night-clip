[Unit]
Description=MoonPassword encrypted vault synchronization
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
StateDirectory=moonpassword-sync
UMask=0077
Environment=GOMEMLIMIT=512MiB
ExecStart=/usr/local/libexec/moonpassword-sync -listen 127.0.0.1:18652 -data /var/lib/moonpassword-sync -issuer https://sso.moonl.cloud -client-id ms_PpTVOukmuReXtAoouKhU
Restart=on-failure
RestartSec=3s
TimeoutStopSec=15s
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
