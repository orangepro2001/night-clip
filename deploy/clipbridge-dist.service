[Unit]
Description=ClipBridge update distribution (cbdist serve)
After=network.target

[Service]
Type=simple
# Loopback only: it is published to the tailnet through `tailscale serve`, never directly.
ExecStart=%h/.local/bin/cbdist serve -dir %h/.local/share/clipbridge/releases -addr 127.0.0.1:18780
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true

[Install]
WantedBy=default.target
