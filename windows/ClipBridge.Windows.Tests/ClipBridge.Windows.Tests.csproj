<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tests the C# side of the DLL boundary (Interop/CoreInterop.cs) without WPF.
       On Linux it loads core/dist/linux-amd64/libclipbridge_core.so (make dll-smoke);
       on Windows it loads core\dist\windows-amd64\clipbridge_core.dll (make dll). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- On Linux the Go core (cgo, own signal handlers) and the runtime's background GC thread crash the test host
         when both are active in one process (measured: 6 of 8 full runs). Blocking GCs are stable. Windows is not affected
         (no signals), and the app itself does not use this switch. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <DistDir>$(MSBuildThisFileDirectory)..\..\core\dist\</DistDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\ClipBridge.Windows\Interop\CoreInterop.cs" Link="Interop\CoreInterop.cs" />
    <Compile Include="..\ClipBridge.Windows\Interop\DevKey.cs" Link="Interop\DevKey.cs" />
    <Compile Include="..\ClipBridge.Windows\Update\UpdateApplier.cs" Link="Update\UpdateApplier.cs" />
    <Compile Include="..\ClipBridge.Windows\Update\UpdateModel.cs" Link="Update\UpdateModel.cs" />
    <!-- All UI-free shell logic (no WPF / WinForms / Win32) is compiled into the tests as well. -->
    <Compile Include="..\ClipBridge.Windows\Strings.cs" Link="Strings.cs" />
    <Compile Include="..\ClipBridge.Windows\StringsVault.cs" Link="StringsVault.cs" />
    <Compile Include="..\ClipBridge.Windows\StringsNotes.cs" Link="StringsNotes.cs" />
    <Compile Include="..\ClipBridge.Windows\Logic\*.cs" Link="Logic\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Linux')) And Exists('$(DistDir)linux-amd64/libclipbridge_core.so')">
    <None Include="$(DistDir)linux-amd64/libclipbridge_core.so" Link="libclipbridge_core.so">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows')) And Exists('$(DistDir)windows-amd64\clipbridge_core.dll')">
    <None Include="$(DistDir)windows-amd64\clipbridge_core.dll" Link="clipbridge_core.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
