<Project Sdk="Microsoft.NET.Sdk">

  <!-- Windows shell: Avalonia 12 + Lumen.UI (docs/ui-lumen-2026-11.md). The Logic/ layer is pure C# and shared
       with the macOS shell and the tests; only Views/, Services/ and App are Windows/Avalonia specific. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- WinForms for the NotifyIcon (tray icon, menu and balloons) only; every window is Avalonia. -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AssemblyName>MoonPassword</AssemblyName>
    <RootNamespace>MoonPassword.Windows</RootNamespace>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <!-- Avalonia and WinForms both define Application, Button, Control, ...: keep the WinForms and System.Drawing
       namespaces out of the implicit usings so that unqualified names mean the Avalonia ones. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <!-- Windows only: the Win32 backend and Skia instead of Avalonia.Desktop (which also ships X11 / macOS / D-Bus). -->
    <PackageReference Include="Avalonia.Win32" Version="12.1.6" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.6" />
    <PackageReference Include="Avalonia.HarfBuzz" Version="12.1.6" />
    <PackageReference Include="Lumen.UI" Version="0.1.0" />
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <!-- Stamped by `make dist-windows` (scripts/version.sh); a plain build is a dev build
       (code 0), which keeps self-update off. The update URL is deliberately not in the
       Makefile: https://release.moonl.cloud unless the git-ignored release.local.env overrides it. -->
  <PropertyGroup>
    <CbVersionCode Condition="'$(CbVersionCode)' == ''">0</CbVersionCode>
    <CbVersionName Condition="'$(CbVersionName)' == ''">0.0.0-dev</CbVersionName>
    <CbUpdateUrl Condition="'$(CbUpdateUrl)' == ''"></CbUpdateUrl>
    <Version>$(CbVersionName)</Version>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>CbVersionCode</_Parameter1>
      <_Parameter2>$(CbVersionCode)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>CbVersionName</_Parameter1>
      <_Parameter2>$(CbVersionName)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>CbUpdateUrl</_Parameter1>
      <_Parameter2>$(CbUpdateUrl)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- moonpassword_core.dll is produced by `make dll` at the repository root. -->
  <PropertyGroup>
    <CoreDll>$(MSBuildThisFileDirectory)..\..\core\dist\windows-amd64\moonpassword_core.dll</CoreDll>
    <SshAgentHost>$(MSBuildThisFileDirectory)..\..\core\dist\windows-amd64\moonpassword-ssh-agent.exe</SshAgentHost>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(CoreDll)')">
    <None Include="$(CoreDll)" Link="moonpassword_core.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup Condition="Exists('$(SshAgentHost)')">
    <None Include="$(SshAgentHost)" Link="moonpassword-ssh-agent.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="WarnMissingCoreDll" BeforeTargets="Build" Condition="!Exists('$(CoreDll)')">
    <Warning Text="moonpassword_core.dll not found at $(CoreDll). Run 'make dll' at the repository root; the app will fail to start without it." />
  </Target>

  <!-- Firefox's development package ships alongside the Windows app. Signed XPI distribution is separate. -->
  <Target Name="PackageFirefoxExtension" AfterTargets="Publish">
    <ZipDirectory SourceDirectory="$(MSBuildThisFileDirectory)..\..\extensions\firefox"
                  DestinationFile="$(PublishDir)MoonPassword-Firefox.zip"
                  Overwrite="true" />
  </Target>

  <!-- Release packages carry no debug symbols: SkiaSharp / HarfBuzz ship large native .pdb files. -->
  <Target Name="ExcludeSymbolsFromPublish" AfterTargets="ComputeResolvedFilesToPublishList" Condition="'$(DebugType)' == 'None' Or '$(DebugType)' == 'none'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish->WithMetadataValue('Extension', '.pdb'))" />
    </ItemGroup>
  </Target>

</Project>
