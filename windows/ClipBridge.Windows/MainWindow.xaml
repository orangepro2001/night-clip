<Window x:Class="ClipBridge.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClipBridge" Width="560" Height="360" MinWidth="420" MinHeight="260">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="StatusLine" Grid.Row="0" FontSize="14" Margin="0,0,0,8"
                   Text="Starting core…" />

        <TextBox x:Name="Log" Grid.Row="1" IsReadOnly="True" FontFamily="Consolas"
                 VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                 HorizontalScrollBarVisibility="Auto" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
            <Button x:Name="RefreshButton" Content="Refresh status" Padding="12,4"
                    Click="RefreshButton_Click" />
        </StackPanel>
    </Grid>
</Window>
