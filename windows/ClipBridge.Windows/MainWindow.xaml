<Window x:Class="ClipBridge.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClipBridge" Width="560" Height="400" MinWidth="420" MinHeight="300">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="StatusLine" Grid.Row="0" FontSize="14" Margin="0,0,0,8"
                   Text="Starting core…" />

        <TextBox x:Name="Log" Grid.Row="1" IsReadOnly="True" FontFamily="Consolas"
                 VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                 HorizontalScrollBarVisibility="Auto" />

        <!-- Self-update: state text, progress while downloading, one action button. -->
        <Border Grid.Row="2" Margin="0,8,0,0" Padding="8" BorderThickness="1" BorderBrush="#FFBBBBBB">
            <StackPanel>
                <DockPanel>
                    <Button x:Name="UpdateButton" DockPanel.Dock="Right" Padding="12,4" MinWidth="130"
                            Click="UpdateButton_Click" IsEnabled="False" Content="Check for updates" />
                    <TextBlock x:Name="UpdateText" VerticalAlignment="Center" Margin="0,0,8,0"
                               TextWrapping="Wrap" Text="Updates" />
                </DockPanel>
                <ProgressBar x:Name="UpdateProgress" Height="6" Margin="0,6,0,0" Maximum="1"
                             Visibility="Collapsed" />
                <CheckBox x:Name="AutoUpdateBox" Margin="0,6,0,0" IsEnabled="False"
                          Content="Download updates automatically"
                          Click="AutoUpdateBox_Click" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
            <Button x:Name="RefreshButton" Content="Refresh status" Padding="12,4"
                    Click="RefreshButton_Click" />
        </StackPanel>
    </Grid>
</Window>
