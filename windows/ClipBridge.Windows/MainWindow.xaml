<Window x:Class="ClipBridge.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ClipBridge.Windows"
        xmlns:views="clr-namespace:ClipBridge.Windows.Views"
        Title="ClipBridge" Width="940" Height="640" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterScreen" Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <Border x:Name="WarningBanner" Background="#FFFFF4CE" BorderBrush="#FFE0B000" BorderThickness="0,0,0,1"
                    Padding="14,8" Visibility="Collapsed">
                <TextBlock x:Name="WarningText" TextWrapping="Wrap" />
            </Border>
            <Border x:Name="UpdateBanner" Background="#FFE6F2FF" BorderBrush="#FF7AA7D9" BorderThickness="0,0,0,1"
                    Padding="14,6" Visibility="Collapsed">
                <DockPanel>
                    <Button x:Name="UpdateBannerButton" DockPanel.Dock="Right" Click="UpdateBannerButton_Click" />
                    <TextBlock x:Name="UpdateBannerText" VerticalAlignment="Center" TextWrapping="Wrap" />
                </DockPanel>
            </Border>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ListBox x:Name="Nav" Grid.Column="0" BorderThickness="0,0,1,0" FontSize="15"
                     SelectionChanged="Nav_SelectionChanged" />
            <Grid Grid.Column="1" Margin="18,14,18,10">
                <views:DevicesPage x:Name="DevicesPage" />
                <views:InboxPage x:Name="InboxPage" Visibility="Collapsed" />
                <views:TransfersPage x:Name="TransfersPage" Visibility="Collapsed" />
                <views:SettingsPage x:Name="SettingsPage" Visibility="Collapsed" />
                <views:DiagnosticsPage x:Name="DiagnosticsPage" Visibility="Collapsed" />
            </Grid>
        </Grid>

        <Border Grid.Row="2" BorderBrush="#FFCCCCCC" BorderThickness="0,1,0,0" Padding="14,5" Background="#FFF6F6F6">
            <DockPanel>
                <TextBlock x:Name="DeviceText" DockPanel.Dock="Right" Foreground="#FF666666" />
                <TextBlock x:Name="StatusText" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
