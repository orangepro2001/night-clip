<Window x:Class="ClipBridge.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ClipBridge.Windows"
        xmlns:views="clr-namespace:ClipBridge.Windows.Views"
        Title="ClipBridge" Width="1040" Height="720" MinWidth="880" MinHeight="540"
        WindowStartupLocation="CenterScreen" Closing="Window_Closing"
        Background="{DynamicResource AppBackground}"
        FontFamily="{DynamicResource AppFont}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <Border x:Name="WarningBanner" Background="{DynamicResource AppWarningSoft}"
                    BorderBrush="{DynamicResource AppWarning}" BorderThickness="0,0,0,1"
                    Padding="16,7" Visibility="Collapsed">
                <TextBlock x:Name="WarningText" TextWrapping="Wrap" Foreground="{DynamicResource AppWarning}" />
            </Border>
            <Border x:Name="UpdateBanner" Background="{DynamicResource AppAccentSoft}"
                    BorderBrush="{DynamicResource AppAccentBorder}" BorderThickness="0,0,0,1"
                    Padding="16,5" Visibility="Collapsed">
                <DockPanel>
                    <Button x:Name="UpdateBannerButton" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}"
                            Click="UpdateBannerButton_Click" />
                    <TextBlock x:Name="UpdateBannerText" VerticalAlignment="Center" TextWrapping="Wrap"
                               Foreground="{DynamicResource AppText}" />
                </DockPanel>
            </Border>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="212" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource AppSurface}"
                    BorderBrush="{DynamicResource AppBorder}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="16,18,16,12">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource AppAccent}">
                                <TextBlock Text="CB" Foreground="White" FontSize="11" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="ClipBridge" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="clipboard bridge" Style="{StaticResource Caption}" Margin="0,1,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <ListBox x:Name="Nav" Grid.Row="1" Style="{StaticResource NavList}"
                             SelectionChanged="Nav_SelectionChanged" />

                    <Border Grid.Row="2" BorderBrush="{DynamicResource AppBorder}" BorderThickness="0,1,0,0"
                            Padding="16,10">
                        <TextBlock Text="本地优先 · 端到端加密" Style="{StaticResource Caption}" />
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="20,14,20,10">
                <views:DevicesPage x:Name="DevicesPage" />
                <views:InboxPage x:Name="InboxPage" Visibility="Collapsed" />
                <views:TransfersPage x:Name="TransfersPage" Visibility="Collapsed" />
                <views:VaultPage x:Name="VaultPage" Visibility="Collapsed" />
                <views:SettingsPage x:Name="SettingsPage" Visibility="Collapsed" />
                <views:DiagnosticsPage x:Name="DiagnosticsPage" Visibility="Collapsed" />
            </Grid>
        </Grid>

        <Border Grid.Row="2" BorderBrush="{DynamicResource AppBorder}" BorderThickness="0,1,0,0"
                Padding="14,4" Background="{DynamicResource AppSurface}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="6" Height="6" Fill="{DynamicResource AppSuccess}" Margin="0,0,6,0" />
                    <TextBlock x:Name="DeviceText" Foreground="{DynamicResource AppMuted}" FontSize="11" />
                </StackPanel>
                <TextBlock x:Name="StatusText" TextTrimming="CharacterEllipsis" FontSize="11"
                           Foreground="{DynamicResource AppMuted}" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
