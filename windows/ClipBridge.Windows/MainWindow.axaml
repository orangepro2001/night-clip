<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="https://github.com/HinaKalo/lumen"
        x:Class="ClipBridge.Windows.MainWindow"
        Title="ClipBridge"
        Width="1100" Height="740" MinWidth="900" MinHeight="580"
        WindowStartupLocation="CenterScreen">

  <l:AppShell x:Name="Shell" Title="ClipBridge" PaneWidth="232">
    <l:AppShell.Logo>
      <l:Icon NameKey="clipboard" Size="16" StrokeThickness="2.25" />
    </l:AppShell.Logo>

    <l:AppShell.HeaderActions>
      <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <!-- Sync state at a glance; click to pause / resume (same as the tray menu). -->
        <Button x:Name="SyncChip" Classes="ghost sm" Click="SyncChip_Click">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <Ellipse x:Name="SyncDot" Width="8" Height="8" VerticalAlignment="Center" />
            <TextBlock x:Name="SyncText" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button x:Name="PairButton" Classes="primary sm" Click="PairButton_Click">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <l:Icon NameKey="qr-code" Size="14" />
            <TextBlock x:Name="PairButtonText" />
          </StackPanel>
        </Button>
        <l:ThemeToggleButton x:Name="ThemeButton" />
      </StackPanel>
    </l:AppShell.HeaderActions>

    <l:AppShell.PaneFooter>
      <Border Padding="10,9" CornerRadius="{DynamicResource Lumen.Radius.Md}"
              Background="{DynamicResource Lumen.Brush.SurfaceSubtle}">
        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
          <Ellipse x:Name="DeviceDot" Grid.RowSpan="2" Width="8" Height="8" Margin="2,0,10,0" VerticalAlignment="Center" />
          <TextBlock x:Name="DeviceText" Grid.Column="1" Classes="caption strong" TextTrimming="CharacterEllipsis" />
          <TextBlock x:Name="DeviceDetail" Grid.Column="1" Grid.Row="1" Classes="caption tertiary" TextTrimming="CharacterEllipsis" />
        </Grid>
      </Border>
    </l:AppShell.PaneFooter>
  </l:AppShell>
</Window>
