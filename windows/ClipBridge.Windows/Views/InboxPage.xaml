<UserControl x:Class="ClipBridge.Windows.Views.InboxPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ClipBridge.Windows">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="{x:Static local:Strings.BtnClear}" Click="Clear_Click" />
            </StackPanel>
            <TextBlock Text="{x:Static local:Strings.InboxTitle}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
        </DockPanel>

        <ListBox x:Name="ItemList" Grid.Row="1" BorderThickness="0" HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Focusable" Value="False" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#FFD5D5D5" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,8"
                            Background="White">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Foreground="#FF777777" FontSize="12">
                                    <Run Text="{Binding FromText, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding TimeText, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding StateText, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Text="{Binding Preview, Mode=OneWay}" TextWrapping="Wrap" MaxHeight="90" Margin="0,4,0,0"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                <Button Content="{Binding RevealText, Mode=OneWay}" Click="Reveal_Click"
                                        Visibility="{Binding CanReveal, Converter={StaticResource B2V}}" />
                                <Button Content="{x:Static local:Strings.BtnCopy}" Click="Copy_Click"
                                        Visibility="{Binding CanCopy, Converter={StaticResource B2V}}" />
                                <Button Content="{x:Static local:Strings.BtnIgnore}" Click="Ignore_Click"
                                        Visibility="{Binding CanDismiss, Converter={StaticResource B2V}}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="EmptyText" Grid.Row="1" Text="{x:Static local:Strings.InboxEmpty}" Foreground="#FF777777"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
    </Grid>
</UserControl>
