<Window x:Class="ClipBridge.Windows.Views.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ClipBridge.Windows"
        Title="ClipBridge" SizeToContent="WidthAndHeight" MinWidth="460" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="24" MaxWidth="440">
        <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,10" />
        <TextBlock x:Name="BodyText" TextWrapping="Wrap" />
        <TextBlock x:Name="TailscaleText" TextWrapping="Wrap" Foreground="#FF666666" Margin="0,10,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="EnableButton" Click="Enable_Click" IsDefault="True" MinWidth="100" />
            <Button x:Name="LaterButton" Click="Later_Click" MinWidth="100" />
        </StackPanel>
    </StackPanel>
</Window>
