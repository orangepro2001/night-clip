<Window x:Class="ClipBridge.Windows.Views.EntryEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ClipBridge.Windows"
        xmlns:views="clr-namespace:ClipBridge.Windows.Views"
        Title="{x:Static local:Strings.EditorNewTitle}" Width="560" Height="720" MinWidth="480" MinHeight="460"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="FormPanel" Margin="18,14,18,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="{x:Static local:Strings.LabelKind}" Margin="0,0,0,4" />
                        <ComboBox x:Name="KindBox" SelectionChanged="KindBox_SelectionChanged" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{x:Static local:Strings.LabelGroup}" Margin="0,0,0,4" />
                        <ComboBox x:Name="GroupCombo" DisplayMemberPath="Display" SelectedValuePath="Id" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="{x:Static local:Strings.LabelTitle}" Margin="0,12,0,4" />
                <TextBox x:Name="TitleBox" MaxLength="2000" />

                <StackPanel x:Name="UserSection">
                    <TextBlock Text="{x:Static local:Strings.LabelUsername}" Margin="0,12,0,4" />
                    <TextBox x:Name="UserBox" />
                </StackPanel>

                <StackPanel x:Name="PwdSection">
                    <TextBlock x:Name="PwdLabel" Text="{x:Static local:Strings.LabelPassword}" Margin="0,12,0,4" />
                    <DockPanel>
                        <Button x:Name="GenerateButton" DockPanel.Dock="Right" Content="{x:Static local:Strings.BtnGenerate}" Click="Generate_Click" />
                        <views:SecretBox x:Name="PwdBox" />
                    </DockPanel>
                    <views:StrengthBar x:Name="PwdStrength" Margin="0,6,0,0" HorizontalAlignment="Left" />
                </StackPanel>

                <StackPanel x:Name="UrlSection">
                    <TextBlock x:Name="UrlLabel" Text="{x:Static local:Strings.LabelUrl}" Margin="0,12,0,4" />
                    <TextBox x:Name="UrlBox" />
                </StackPanel>

                <StackPanel x:Name="TotpSection">
                    <TextBlock Text="{x:Static local:Strings.LabelTotp}" Margin="0,12,0,4" />
                    <views:SecretBox x:Name="TotpBox" />
                </StackPanel>

                <StackPanel x:Name="ExpirySection">
                    <TextBlock Text="{x:Static local:Strings.LabelExpiry}" Margin="0,12,0,4" />
                    <DatePicker x:Name="ExpiryPicker" HorizontalAlignment="Left" Width="180" />
                </StackPanel>

                <StackPanel x:Name="TagsSection">
                    <TextBlock Text="{x:Static local:Strings.LabelTags}" Margin="0,12,0,4" />
                    <TextBox x:Name="TagsBox" />
                </StackPanel>

                <StackPanel x:Name="NotesSection">
                    <TextBlock Text="{x:Static local:Strings.LabelNotes}" Margin="0,12,0,4" />
                    <TextBox x:Name="NotesBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" MaxHeight="260" VerticalScrollBarVisibility="Auto" />
                </StackPanel>

                <StackPanel x:Name="FieldsSection">
                    <TextBlock Text="{x:Static local:Strings.LabelCustomFields}" Margin="0,14,0,4" FontWeight="SemiBold" />
                    <StackPanel x:Name="FieldsPanel" />
                    <WrapPanel x:Name="SuggestionPanel" Margin="0,4,0,0" />
                    <Button Content="{x:Static local:Strings.BtnAddField}" HorizontalAlignment="Left" Margin="0,6,0,0" Click="AddField_Click" />
                </StackPanel>

                <TextBlock x:Name="ErrorText" Foreground="#FFC62828" TextWrapping="Wrap" Margin="0,14,0,0" />
                <TextBlock x:Name="WarnText" Foreground="#FFB36B00" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" BorderBrush="#FFDDDDDD" BorderThickness="0,1,0,0" Padding="18,10" Background="#FFF6F6F6">
            <DockPanel>
                <TextBlock x:Name="LoadingText" Text="{x:Static local:Strings.EditorLoading}" Foreground="#FF777777" VerticalAlignment="Center" Visibility="Collapsed" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="SaveButton" Content="{x:Static local:Strings.BtnSave}" MinWidth="90" IsDefault="True" Click="Save_Click" />
                    <Button Content="{x:Static local:Strings.BtnCancel}" MinWidth="90" Click="Cancel_Click" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
