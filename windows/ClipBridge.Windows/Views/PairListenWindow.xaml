<Window x:Class="ClipBridge.Windows.Views.PairListenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ClipBridge.Windows"
        Title="ClipBridge" SizeToContent="WidthAndHeight" MinWidth="460" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="20" MaxWidth="440">
        <TextBlock x:Name="IntroText" TextWrapping="Wrap" Margin="0,0,0,12" />
        <Border Background="White" BorderBrush="#FFCCCCCC" BorderThickness="1" HorizontalAlignment="Center"
                MinWidth="200" MinHeight="200">
            <Grid>
                <Image x:Name="QrImage" Stretch="None" RenderOptions.BitmapScalingMode="NearestNeighbor"
                       HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True" />
                <TextBlock x:Name="QrMissing" TextWrapping="Wrap" Margin="12" Visibility="Collapsed"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </Border>
        <TextBlock x:Name="CountdownText" HorizontalAlignment="Center" FontSize="15" Margin="0,10,0,0" />
        <DockPanel Margin="0,12,0,0">
            <Button x:Name="CopyButton" DockPanel.Dock="Right" Click="Copy_Click" />
            <TextBox x:Name="LinkBox" IsReadOnly="True" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" />
        </DockPanel>
        <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,10,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="CloseButton" Click="Close_Click" />
        </StackPanel>
    </StackPanel>
</Window>
