<UserControl x:Class="ClipBridge.Windows.Views.VaultPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ClipBridge.Windows"
             xmlns:views="clr-namespace:ClipBridge.Windows.Views">
    <Grid>
        <TextBlock x:Name="LoadingText" Text="{x:Static local:Strings.VaultLoading}" Foreground="{DynamicResource AppMuted}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
        <views:VaultLockPanel x:Name="LockPanel" Visibility="Collapsed" />
        <views:VaultMainPanel x:Name="MainPanel" Visibility="Collapsed" />
    </Grid>
</UserControl>
