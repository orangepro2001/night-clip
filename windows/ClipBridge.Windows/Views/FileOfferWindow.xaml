<Window x:Class="ClipBridge.Windows.Views.FileOfferWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ClipBridge.Windows"
        Title="ClipBridge" SizeToContent="WidthAndHeight" MinWidth="460" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="20" MaxWidth="480">
        <TextBlock x:Name="FromText" TextWrapping="Wrap" FontSize="15" />
        <TextBlock x:Name="NameText" TextWrapping="Wrap" FontSize="18" FontWeight="SemiBold" Margin="0,10,0,0" />
        <TextBlock x:Name="SizeText" Foreground="#FF666666" Margin="0,2,0,0" />
        <TextBlock x:Name="DangerText" Foreground="Firebrick" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed" />
        <TextBlock x:Name="SaveLabel" Margin="0,14,0,4" />
        <DockPanel>
            <Button x:Name="ChangeButton" DockPanel.Dock="Right" Click="Change_Click" />
            <TextBox x:Name="DirBox" IsReadOnly="True" />
        </DockPanel>
        <TextBlock x:Name="StatusText" Foreground="Firebrick" TextWrapping="Wrap" Margin="0,8,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="AcceptButton" Click="Accept_Click" IsDefault="True" MinWidth="90" />
            <Button x:Name="RejectButton" Click="Reject_Click" MinWidth="90" />
            <Button x:Name="LaterButton" Click="Later_Click" />
        </StackPanel>
    </StackPanel>
</Window>
