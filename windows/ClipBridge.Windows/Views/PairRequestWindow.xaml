<Window x:Class="ClipBridge.Windows.Views.PairRequestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ClipBridge.Windows"
        Title="ClipBridge" SizeToContent="WidthAndHeight" MinWidth="420" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Topmost="True">
    <StackPanel Margin="22" MaxWidth="400">
        <TextBlock x:Name="RequestText" TextWrapping="Wrap" FontSize="15" />
        <TextBlock x:Name="SasPrompt" TextWrapping="Wrap" Margin="0,14,0,0" HorizontalAlignment="Center" />
        <TextBlock x:Name="SasText" FontSize="52" FontWeight="Bold" FontFamily="Consolas" HorizontalAlignment="Center"
                   Margin="0,4,0,4" />
        <TextBlock x:Name="CountdownText" HorizontalAlignment="Center" Foreground="{DynamicResource AppMuted}" />
        <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,8,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="AllowButton" Click="Allow_Click" IsDefault="True" MinWidth="90" />
            <Button x:Name="DenyButton" Click="Deny_Click" MinWidth="90" />
        </StackPanel>
    </StackPanel>
</Window>
