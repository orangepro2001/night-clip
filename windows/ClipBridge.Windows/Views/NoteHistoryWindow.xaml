<Window x:Class="ClipBridge.Windows.Views.NoteHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ClipBridge.Windows"
        Title="ClipBridge" Width="780" Height="520" MinWidth="620" MinHeight="380"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Row="0" Grid.Column="0">
            <Button x:Name="MoreButton" DockPanel.Dock="Bottom" Content="{x:Static local:Strings.BtnNoteLoadMore}" Click="More_Click"
                    Margin="0,6,0,0" Visibility="Collapsed" />
            <ListBox x:Name="RevList" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionChanged="RevList_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="2,3">
                            <TextBlock Text="{Binding TimeText, Mode=OneWay}" FontWeight="SemiBold" />
                            <TextBlock Foreground="{DynamicResource AppMuted}" FontSize="12" TextTrimming="CharacterEllipsis">
                                <Run Text="{Binding OriginText, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Title, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <DockPanel Grid.Row="0" Grid.Column="2">
            <TextBlock x:Name="InfoText" DockPanel.Dock="Top" Foreground="{DynamicResource AppMuted}" TextWrapping="Wrap" Margin="0,0,0,6" />
            <TextBox x:Name="BodyBox" Style="{StaticResource NotesEditorBox}" IsReadOnly="True" />
        </DockPanel>

        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="UseButton" Content="{x:Static local:Strings.BtnNoteUseRevision}" Click="Use_Click" IsEnabled="False"
                    Style="{StaticResource PrimaryButton}" MinWidth="110" />
            <Button Content="{x:Static local:Strings.Close}" IsCancel="True" Click="Close_Click" MinWidth="80" />
        </StackPanel>
    </Grid>
</Window>
