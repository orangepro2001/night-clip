<UserControl x:Class="ClipBridge.Windows.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ClipBridge.Windows">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="{x:Static local:Strings.SettingsTitle}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="同步、后台、更新与诊断" Style="{StaticResource PageSubtitle}" />

            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="同步" Style="{StaticResource SectionTitle}" />
                    <CheckBox x:Name="SyncBox" Content="{x:Static local:Strings.SettingsSync}" Click="SyncBox_Click" />
                    <TextBlock Text="{x:Static local:Strings.SettingsSyncHint}" Foreground="{DynamicResource AppMuted}" FontSize="11"
                               Margin="20,0,0,8" TextWrapping="Wrap" />

                    <TextBlock Text="{x:Static local:Strings.SettingsDefaultMode}" Margin="0,4,0,3" />
                    <ComboBox x:Name="ModeBox" Width="190" HorizontalAlignment="Left" SelectedValuePath="Tag">
                        <ComboBoxItem Tag="notify" Content="{x:Static local:Strings.ModeNotify}" />
                        <ComboBoxItem Tag="manual" Content="{x:Static local:Strings.ModeManual}" />
                        <ComboBoxItem Tag="auto" Content="{x:Static local:Strings.ModeAuto}" />
                    </ComboBox>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{x:Static local:Strings.SettingsTtl}" Margin="0,0,0,3" />
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="TtlBox" Width="90" TextChanged="TtlBox_TextChanged" />
                                <TextBlock x:Name="TtlHint" Foreground="{DynamicResource AppMuted}" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="11" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="24,0,0,0">
                            <TextBlock Text="{x:Static local:Strings.SettingsHistory}" Margin="0,0,0,3" />
                            <TextBox x:Name="HistoryBox" Width="90" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Grid>

                    <CheckBox x:Name="SensitiveDetectionBox" Content="{x:Static local:Strings.SettingsSensitiveDetection}" Margin="0,10,0,0" />
                    <TextBlock Text="{x:Static local:Strings.SettingsSensitiveDetectionHint}" Foreground="{DynamicResource AppMuted}" FontSize="11"
                               Margin="20,0,0,0" TextWrapping="Wrap" />
                    <CheckBox x:Name="SensitiveBox" Content="{x:Static local:Strings.SettingsSendSensitive}" Margin="0,8,0,0" />
                    <CheckBox x:Name="AutoStartBox" Content="{x:Static local:Strings.SettingsAutoStart}" Margin="0,4,0,0"
                              Click="AutoStartBox_Click" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="文件" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{x:Static local:Strings.SettingsDownloadDir}" Margin="0,2,0,3" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="{x:Static local:Strings.BtnBrowse}" Click="Browse_Click" />
                        <TextBox x:Name="DirBox" />
                    </DockPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="{x:Static local:Strings.SettingsSave}" Click="Save_Click" Margin="0"
                                Style="{StaticResource PrimaryButton}" />
                        <TextBlock x:Name="SaveResult" VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap" FontSize="11" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="{x:Static local:Strings.SettingsFirewallTitle}" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{x:Static local:Strings.SettingsFirewallText}" TextWrapping="Wrap" Foreground="{DynamicResource AppMuted}" FontSize="11" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="{x:Static local:Strings.SettingsUpdateTitle}" Style="{StaticResource SectionTitle}" />
                    <DockPanel Margin="0,2,0,0">
                        <Button x:Name="UpdateButton" DockPanel.Dock="Right" MinWidth="120" Click="UpdateButton_Click" />
                        <TextBlock x:Name="UpdateText" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="11" />
                    </DockPanel>
                    <ProgressBar x:Name="UpdateProgress" Height="6" Margin="0,6,0,0" Maximum="1" Visibility="Collapsed" />
                    <CheckBox x:Name="AutoUpdateBox" Content="{x:Static local:Strings.UpdateAuto}" Margin="0,6,0,0" Click="AutoUpdateBox_Click" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="{x:Static local:Strings.SettingsAboutTitle}" Style="{StaticResource SectionTitle}" />
                    <TextBlock x:Name="AboutVersion" FontSize="11" />
                    <TextBlock x:Name="AboutDevice" FontSize="11" />
                    <TextBlock x:Name="AboutFingerprint" Margin="0,0,0,4" FontSize="11" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
