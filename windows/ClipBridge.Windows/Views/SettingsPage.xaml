<UserControl x:Class="ClipBridge.Windows.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ClipBridge.Windows">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="680" HorizontalAlignment="Left">
            <TextBlock Text="{x:Static local:Strings.SettingsTitle}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />

            <CheckBox x:Name="SyncBox" Content="{x:Static local:Strings.SettingsSync}" Click="SyncBox_Click" FontSize="14" />
            <TextBlock Text="{x:Static local:Strings.SettingsSyncHint}" Foreground="#FF777777" FontSize="12" Margin="20,2,0,12"
                       TextWrapping="Wrap" />

            <TextBlock Text="{x:Static local:Strings.SettingsDefaultMode}" Margin="0,4,0,4" />
            <ComboBox x:Name="ModeBox" Width="180" HorizontalAlignment="Left" SelectedValuePath="Tag">
                <ComboBoxItem Tag="notify" Content="{x:Static local:Strings.ModeNotify}" />
                <ComboBoxItem Tag="manual" Content="{x:Static local:Strings.ModeManual}" />
                <ComboBoxItem Tag="auto" Content="{x:Static local:Strings.ModeAuto}" />
            </ComboBox>

            <TextBlock Text="{x:Static local:Strings.SettingsTtl}" Margin="0,12,0,4" />
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="TtlBox" Width="100" TextChanged="TtlBox_TextChanged" />
                <TextBlock x:Name="TtlHint" Foreground="#FF777777" VerticalAlignment="Center" Margin="10,0,0,0" />
            </StackPanel>

            <TextBlock Text="{x:Static local:Strings.SettingsHistory}" Margin="0,12,0,4" />
            <TextBox x:Name="HistoryBox" Width="100" HorizontalAlignment="Left" />

            <CheckBox x:Name="SensitiveDetectionBox" Content="{x:Static local:Strings.SettingsSensitiveDetection}" Margin="0,12,0,0" />
            <TextBlock Text="{x:Static local:Strings.SettingsSensitiveDetectionHint}" Foreground="#FF777777" FontSize="12" Margin="20,2,0,0"
                       TextWrapping="Wrap" />
            <CheckBox x:Name="SensitiveBox" Content="{x:Static local:Strings.SettingsSendSensitive}" Margin="0,12,0,0" />
            <CheckBox x:Name="AutoStartBox" Content="{x:Static local:Strings.SettingsAutoStart}" Margin="0,8,0,0"
                      Click="AutoStartBox_Click" />

            <TextBlock Text="{x:Static local:Strings.SettingsDownloadDir}" Margin="0,12,0,4" />
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="{x:Static local:Strings.BtnBrowse}" Click="Browse_Click" />
                <TextBox x:Name="DirBox" />
            </DockPanel>

            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Button Content="{x:Static local:Strings.SettingsSave}" Click="Save_Click" Margin="0" />
                <TextBlock x:Name="SaveResult" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" />
            </StackPanel>

            <Separator Margin="0,20,0,12" />
            <TextBlock Text="{x:Static local:Strings.SettingsFirewallTitle}" FontWeight="SemiBold" />
            <TextBlock Text="{x:Static local:Strings.SettingsFirewallText}" TextWrapping="Wrap" Foreground="#FF555555" Margin="0,4,0,0" />

            <Separator Margin="0,20,0,12" />
            <TextBlock Text="{x:Static local:Strings.SettingsUpdateTitle}" FontWeight="SemiBold" />
            <DockPanel Margin="0,6,0,0">
                <Button x:Name="UpdateButton" DockPanel.Dock="Right" MinWidth="120" Click="UpdateButton_Click" />
                <TextBlock x:Name="UpdateText" VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>
            <ProgressBar x:Name="UpdateProgress" Height="6" Margin="0,6,0,0" Maximum="1" Visibility="Collapsed" />
            <CheckBox x:Name="AutoUpdateBox" Content="{x:Static local:Strings.UpdateAuto}" Margin="0,8,0,0" Click="AutoUpdateBox_Click" />

            <Separator Margin="0,20,0,12" />
            <TextBlock Text="{x:Static local:Strings.SettingsAboutTitle}" FontWeight="SemiBold" />
            <TextBlock x:Name="AboutVersion" Margin="0,4,0,0" />
            <TextBlock x:Name="AboutDevice" />
            <TextBlock x:Name="AboutFingerprint" Margin="0,0,0,24" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
