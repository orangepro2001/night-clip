<UserControl x:Class="ClipBridge.Windows.Views.DevicesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ClipBridge.Windows">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="{x:Static local:Strings.BtnSendFiles}" Click="SendFiles_Click" />
                <Button Content="{x:Static local:Strings.BtnJoinPair}" Click="Join_Click" />
                <Button Content="{x:Static local:Strings.BtnPairNew}" Click="Pair_Click" Style="{StaticResource PrimaryButton}" />
            </StackPanel>
            <StackPanel><TextBlock Text="{x:Static local:Strings.DevicesTitle}" Style="{StaticResource PageTitle}" /><TextBlock Text="已配对设备、自动发送与文件传输" Style="{StaticResource PageSubtitle}" /></StackPanel>
        </DockPanel>

        <ListBox x:Name="PeerList" Grid.Row="1" BorderThickness="0" HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="AllowDrop" Value="True" />
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <EventSetter Event="DragOver" Handler="Peer_DragOver" />
                    <EventSetter Event="Drop" Handler="Peer_Drop" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource CardBorder}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DisplayName, Mode=OneWay}" FontSize="16" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Margin="0,2,0,0" TextWrapping="Wrap" Foreground="{DynamicResource AppMuted}">
                                    <Run Text="{Binding PlatformText, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding StateText, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Text="{Binding LastSeenText, Mode=OneWay}" Foreground="{DynamicResource AppMuted}" FontSize="12" />
                                <TextBlock Text="{Binding PendingText, Mode=OneWay}" Foreground="{DynamicResource AppWarning}" FontSize="12" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <CheckBox Content="{x:Static local:Strings.DeviceAutoSend}" IsChecked="{Binding SendEnabled, Mode=OneWay}"
                                          ToolTip="{x:Static local:Strings.DeviceAutoSendTip}" Click="Send_Click"
                                          VerticalAlignment="Center" Margin="0,0,10,0"
                                          Visibility="{Binding CanChangeSettings, Converter={StaticResource B2V}}" />
                                <ComboBox Width="112" SelectedValuePath="Tag" SelectedValue="{Binding ApplyMode, Mode=OneWay}"
                                          ToolTip="{x:Static local:Strings.LabelPolicy}" SelectionChanged="Mode_Changed"
                                          Visibility="{Binding CanChangeSettings, Converter={StaticResource B2V}}">
                                    <ComboBoxItem Tag="notify" Content="{x:Static local:Strings.ModeNotify}" />
                                    <ComboBoxItem Tag="manual" Content="{x:Static local:Strings.ModeManual}" />
                                    <ComboBoxItem Tag="auto" Content="{x:Static local:Strings.ModeAuto}" />
                                </ComboBox>
                                <Button Content="{x:Static local:Strings.BtnSendFiles}" Click="SendOne_Click"
                                        Visibility="{Binding CanSendFile, Converter={StaticResource B2V}}" />
                                <Button Content="{x:Static local:Strings.BtnRename}" Click="Rename_Click"
                                        Visibility="{Binding CanChangeSettings, Converter={StaticResource B2V}}" />
                                <Button Content="{x:Static local:Strings.BtnReconnect}" Click="Reconnect_Click"
                                        Visibility="{Binding CanReconnect, Converter={StaticResource B2V}}" />
                                <Button Content="{x:Static local:Strings.BtnUnpair}" Click="Unpair_Click"
                                        Visibility="{Binding CanChangeSettings, Converter={StaticResource B2V}}" />
                                <Button Content="{x:Static local:Strings.BtnForget}" Click="Forget_Click"
                                        Visibility="{Binding IsRevoked, Converter={StaticResource B2V}}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock x:Name="EmptyText" Grid.Row="1" Text="{x:Static local:Strings.DevicesEmpty}" Foreground="{DynamicResource AppMuted}"
                   TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
        <TextBlock Grid.Row="2" Text="{x:Static local:Strings.DropFilesHint}" Foreground="{DynamicResource AppFaint}" FontSize="12"
                   Margin="2,6,0,0" />
    </Grid>
</UserControl>
