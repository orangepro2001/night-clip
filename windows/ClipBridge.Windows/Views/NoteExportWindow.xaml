<Window x:Class="ClipBridge.Windows.Views.NoteExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ClipBridge.Windows"
        Title="ClipBridge" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="18">
        <TextBlock Text="{x:Static local:Strings.NoteExportIntro}" TextWrapping="Wrap" />
        <CheckBox x:Name="TrashBox" Content="{x:Static local:Strings.NoteExportTrash}" Margin="0,12,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="ChooseButton" Content="{x:Static local:Strings.BtnNoteExportChoose}" Click="Choose_Click" IsDefault="True"
                    Style="{StaticResource PrimaryButton}" MinWidth="130" />
            <Button Content="{x:Static local:Strings.BtnCancel}" IsCancel="True" MinWidth="80" />
        </StackPanel>
    </StackPanel>
</Window>
