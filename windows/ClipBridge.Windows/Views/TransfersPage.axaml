<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="https://github.com/HinaKalo/lumen"
             xmlns:logic="using:ClipBridge.Windows.Logic"
             xmlns:cb="using:ClipBridge.Windows"
             x:Class="ClipBridge.Windows.Views.TransfersPage">
  <Grid Classes="page" RowDefinitions="Auto,*">
    <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,0,0,14">
      <l:SegmentedControl x:Name="Filter" SelectionChanged="Filter_Changed">
        <l:SegmentedItem x:Name="FilterAll" />
        <l:SegmentedItem x:Name="FilterActive" />
        <l:SegmentedItem x:Name="FilterDone" />
      </l:SegmentedControl>
      <Button Grid.Column="2" Classes="ghost" Margin="0,0,6,0" Click="Folder_Click">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <l:Icon NameKey="folder-open" Size="15" />
          <TextBlock x:Name="FolderText" />
        </StackPanel>
      </Button>
      <Button Grid.Column="3" Classes="ghost icon" Click="Refresh_Click" x:Name="RefreshButton">
        <l:Icon Kind="RefreshCw" Size="15" />
      </Button>
    </Grid>

    <Panel Grid.Row="1">
      <l:Card x:Name="ListCard" Classes="flat" Padding="0" ClipToBounds="True" VerticalAlignment="Top">
        <ScrollViewer>
          <ItemsControl x:Name="Items" Margin="0,0,0,-1">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <VirtualizingStackPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="logic:TransferRow">
                <Border Classes="row">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <Border Classes="tile" Classes.accent="{Binding IsActive}" Classes.success="{Binding IsDone}"
                            Classes.danger="{Binding IsFailed}" VerticalAlignment="Top">
                      <Panel>
                        <l:Icon Kind="Download" Size="17" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding Incoming}" />
                        <l:Icon Kind="Upload" Size="17" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !Incoming}" />
                      </Panel>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,12,0" Spacing="4" VerticalAlignment="Center">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Classes="medium" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                   ToolTip.Tip="{Binding Name}" />
                        <l:Badge Classes="dot" Classes.accent="{Binding IsActive}" Classes.success="{Binding IsDone}"
                                 Classes.danger="{Binding IsFailed}" Content="{Binding StateText}" />
                      </StackPanel>
                      <TextBlock Classes="caption tertiary">
                        <Run Text="{Binding DirectionText}" /><Run Text="  ·  " /><Run Text="{Binding PeerName}" /><Run Text="  ·  " /><Run Text="{Binding SizeText}" />
                      </TextBlock>
                      <ProgressBar Minimum="0" Maximum="1" Height="6" MinHeight="6" Margin="0,4,0,0" Value="{Binding Progress}"
                                   IsVisible="{Binding ShowProgress}" />
                      <TextBlock Classes="caption secondary" Text="{Binding Detail}" IsVisible="{Binding ShowProgress}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                      <Button Classes="primary sm" Content="{x:Static cb:Strings.BtnAccept}" IsVisible="{Binding CanAccept}" Click="Accept_Click" />
                      <Button Classes="ghost sm" Content="{x:Static cb:Strings.BtnReject}" IsVisible="{Binding CanReject}" Click="Reject_Click" />
                      <Button Classes="ghost sm" Content="{x:Static cb:Strings.BtnCancel}" IsVisible="{Binding CanCancel}" Click="Cancel_Click" />
                      <Button Classes="soft sm" Content="{x:Static cb:Strings.BtnOpenFile}" IsVisible="{Binding CanOpen}" Click="Open_Click" />
                      <Button Classes="ghost icon sm" ToolTip.Tip="{x:Static cb:Strings.BtnOpenFolder}" IsVisible="{Binding CanOpen}" Click="Folder_Row_Click">
                        <l:Icon NameKey="folder-open" Size="14" />
                      </Button>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </l:Card>
      <l:EmptyState x:Name="Empty" Icon="Package" />
    </Panel>
  </Grid>
</UserControl>
