<Window x:Class="ClipBridge.Windows.Views.InputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClipBridge" Width="380" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="18">
        <TextBlock x:Name="PromptText" Margin="0,0,0,6" />
        <TextBox x:Name="InputBox" />
        <TextBlock x:Name="ErrorText" Foreground="Firebrick" TextWrapping="Wrap" Margin="0,6,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="OkButton" Click="Ok_Click" IsDefault="True" MinWidth="80" />
            <Button x:Name="CancelButton" MinWidth="80" Click="Cancel_Click" />
        </StackPanel>
    </StackPanel>
</Window>
