<UserControl x:Class="ClipBridge.Windows.Views.NoteEditorPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ClipBridge.Windows"
             xmlns:views="clr-namespace:ClipBridge.Windows.Views">
    <Grid>
        <TextBlock x:Name="EmptyText" Text="{x:Static local:Strings.NoteEditorEmpty}" Foreground="{DynamicResource AppMuted}"
                   TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" />

        <Grid x:Name="EditorGrid" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- title and note actions -->
            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                    <Button x:Name="HistoryButton" Content="{x:Static local:Strings.BtnNoteHistory}" Click="History_Click" />
                    <Button x:Name="DeleteButton" Content="{x:Static local:Strings.BtnNoteDelete}" Click="Delete_Click" />
                </StackPanel>
                <Grid>
                    <TextBox x:Name="TitleBox" FontSize="16" FontWeight="SemiBold" MaxLength="300" Padding="10,6"
                             TextChanged="Title_TextChanged" PreviewKeyDown="Title_PreviewKeyDown" />
                    <TextBlock x:Name="TitleHint" Text="{x:Static local:Strings.NoteTitleHint}" Foreground="{DynamicResource AppFaint}"
                               FontSize="16" IsHitTestVisible="False" Margin="12,0,0,0" VerticalAlignment="Center" />
                </Grid>
            </DockPanel>

            <!-- the note is in the recycle bin -->
            <Border x:Name="TrashBanner" Grid.Row="1" Visibility="Collapsed" Margin="0,0,0,8" Padding="10,6" CornerRadius="7"
                    Background="{DynamicResource AppWarningSoft}" BorderBrush="{DynamicResource AppWarning}" BorderThickness="1">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="{x:Static local:Strings.BtnNoteRestore}" Click="Restore_Click" />
                    <TextBlock x:Name="TrashText" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource AppWarning}" />
                </DockPanel>
            </Border>

            <!-- formatting toolbar and the Source | Split | Preview switch -->
            <DockPanel Grid.Row="2" Margin="0,0,0,4">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="8,0,0,4">
                    <ToggleButton x:Name="ModeSource" Style="{StaticResource NotesModeToggle}" Tag="Source"
                                  Content="{x:Static local:Strings.NoteViewSource}" Click="Mode_Click" />
                    <ToggleButton x:Name="ModeSplit" Style="{StaticResource NotesModeToggle}" Tag="Split" Margin="-1,0,0,0"
                                  Content="{x:Static local:Strings.NoteViewSplit}" Click="Mode_Click" />
                    <ToggleButton x:Name="ModePreview" Style="{StaticResource NotesModeToggle}" Tag="Preview" Margin="-1,0,0,0"
                                  Content="{x:Static local:Strings.NoteViewPreview}" Click="Mode_Click" />
                </StackPanel>
                <WrapPanel x:Name="Toolbar">
                    <Button Style="{StaticResource NotesFormatButton}" Tag="Bold" Click="Format_Click" Content="B" FontWeight="Bold"
                            ToolTip="{x:Static local:Strings.EditBoldTip}" />
                    <Button Style="{StaticResource NotesFormatButton}" Tag="Italic" Click="Format_Click" Content="I" FontStyle="Italic"
                            ToolTip="{x:Static local:Strings.EditItalicTip}" />
                    <Button Style="{StaticResource NotesFormatButton}" Tag="Strikethrough" Click="Format_Click"
                            ToolTip="{x:Static local:Strings.EditStrikeTip}">
                        <TextBlock Text="S" TextDecorations="Strikethrough" />
                    </Button>
                    <Button Style="{StaticResource NotesFormatButton}" Tag="InlineCode" Click="Format_Click" Content="&lt;/&gt;"
                            ToolTip="{x:Static local:Strings.EditCodeTip}" />
                    <Button Style="{StaticResource NotesFormatButton}" Tag="Heading1" Click="Format_Click" Content="H1"
                            ToolTip="{x:Static local:Strings.EditHeadingTip1}" Margin="8,0,4,4" />
                    <Button Style="{StaticResource NotesFormatButton}" Tag="Heading2" Click="Format_Click" Content="H2"
                            ToolTip="{x:Static local:Strings.EditHeadingTip2}" />
                    <Button Style="{StaticResource NotesFormatButton}" Tag="Heading3" Click="Format_Click" Content="H3"
                            ToolTip="{x:Static local:Strings.EditHeadingTip3}" />
                    <Button Style="{StaticResource NotesFormatButton}" Tag="BulletList" Click="Format_Click" Content="•"
                            ToolTip="{x:Static local:Strings.EditBulletTip}" Margin="8,0,4,4" />
                    <Button Style="{StaticResource NotesFormatButton}" Tag="NumberedList" Click="Format_Click" Content="1."
                            ToolTip="{x:Static local:Strings.EditNumberedTip}" />
                    <Button Style="{StaticResource NotesFormatButton}" Tag="TaskList" Click="Format_Click" Content="☐"
                            ToolTip="{x:Static local:Strings.EditTaskTip}" />
                    <Button Style="{StaticResource NotesFormatButton}" Tag="Quote" Click="Format_Click" Content="❝"
                            ToolTip="{x:Static local:Strings.EditQuoteTip}" />
                    <Button Style="{StaticResource NotesFormatButton}" Tag="CodeBlock" Click="Format_Click" Content="{x:Static local:Strings.EditCodeBlockLabel}"
                            ToolTip="{x:Static local:Strings.EditCodeBlockTip}" />
                    <Button Style="{StaticResource NotesFormatButton}" Tag="Link" Click="Format_Click" Content="{x:Static local:Strings.EditLinkLabel}"
                            ToolTip="{x:Static local:Strings.EditLinkTip}" />
                    <Button Style="{StaticResource NotesFormatButton}" Tag="HorizontalRule" Click="Format_Click" Content="—"
                            ToolTip="{x:Static local:Strings.EditRuleTip}" />
                </WrapPanel>
            </DockPanel>

            <!-- the Markdown source and the preview -->
            <Grid x:Name="ContentGrid" Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SourceColumn" Width="*" />
                    <ColumnDefinition x:Name="SplitterColumn" Width="8" />
                    <ColumnDefinition x:Name="PreviewColumn" Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SourceBox" Grid.Column="0" Style="{StaticResource NotesEditorBox}" SpellCheck.IsEnabled="False"
                         UndoLimit="500" TextChanged="Source_TextChanged" PreviewKeyDown="Source_PreviewKeyDown" />
                <GridSplitter x:Name="Splitter" Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent"
                              ResizeBehavior="PreviousAndNext" />
                <Border x:Name="PreviewFrame" Grid.Column="2" BorderThickness="1" CornerRadius="7"
                        BorderBrush="{DynamicResource AppBorder}" Background="{DynamicResource AppSurfaceAlt}">
                    <views:NotePreview x:Name="Preview" />
                </Border>
            </Grid>

            <DockPanel Grid.Row="4" Margin="0,8,0,0">
                <Button x:Name="RetryButton" DockPanel.Dock="Right" Content="{x:Static local:Strings.BtnNoteSaveNow}" Click="SaveNow_Click"
                        Padding="8,2" Visibility="Collapsed" />
                <TextBlock x:Name="StatusText" Style="{StaticResource Caption}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
