<UserControl x:Class="ClipBridge.Windows.Views.NotesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ClipBridge.Windows"
             xmlns:views="clr-namespace:ClipBridge.Windows.Views">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <ToggleButton x:Name="TrashToggle" Style="{StaticResource NotesModeToggle}" Margin="0,0,8,0"
                              Content="{x:Static local:Strings.BtnNoteTrash}" Click="Trash_Click" />
                <Button x:Name="MenuButton" Content="{x:Static local:Strings.BtnNoteMore}" Click="Menu_Click">
                    <Button.ContextMenu>
                        <ContextMenu x:Name="NotesMenu">
                            <MenuItem Header="{x:Static local:Strings.MenuNoteExport}" Click="Export_Click" />
                            <MenuItem Header="{x:Static local:Strings.MenuNoteImport}" Click="Import_Click" />
                            <MenuItem Header="{x:Static local:Strings.MenuNoteImportFolder}" Click="ImportFolder_Click" />
                            <Separator />
                            <MenuItem Header="{x:Static local:Strings.MenuNoteCleanup}" Click="Cleanup_Click" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button x:Name="NewButton" Content="{x:Static local:Strings.BtnNoteNew}" Click="New_Click" Style="{StaticResource PrimaryButton}" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="{x:Static local:Strings.NotesTitle}" Style="{StaticResource PageTitle}" />
                <TextBlock Text="{x:Static local:Strings.NotesSubtitle}" Style="{StaticResource PageSubtitle}" />
            </StackPanel>
        </DockPanel>

        <!-- notices and the conflict banner -->
        <StackPanel Grid.Row="1">
            <Border x:Name="NoticeBanner" Visibility="Collapsed" Margin="0,0,0,8" Padding="12,6" CornerRadius="7"
                    Background="{DynamicResource AppAccentSoft}" BorderBrush="{DynamicResource AppAccentBorder}" BorderThickness="1">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="{x:Static local:Strings.Close}" Click="CloseNotice_Click" />
                    <TextBlock x:Name="NoticeText" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
            </Border>
            <Border x:Name="ConflictBanner" Visibility="Collapsed" Margin="0,0,0,8" Padding="12,6" CornerRadius="7"
                    Background="{DynamicResource AppWarningSoft}" BorderBrush="{DynamicResource AppWarning}" BorderThickness="1">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="{x:Static local:Strings.BtnNoteResolveConflicts}" Click="Conflicts_Click" />
                    <TextBlock x:Name="ConflictText" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource AppWarning}" />
                </DockPanel>
            </Border>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="200" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <!-- the notes -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <TextBox x:Name="SearchBox" MaxLength="200" Padding="8,5" TextChanged="SearchBox_TextChanged"
                             PreviewKeyDown="SearchBox_PreviewKeyDown" />
                    <TextBlock x:Name="SearchHint" Text="{x:Static local:Strings.NoteSearchHint}" Foreground="{DynamicResource AppFaint}"
                               IsHitTestVisible="False" Margin="10,0,0,0" VerticalAlignment="Center" />
                </Grid>
                <ListBox x:Name="NoteList" Grid.Row="1" HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="NoteList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2,3">
                                <views:HighlightText Segments="{Binding TitleSegments, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <views:HighlightText Segments="{Binding PreviewSegments, Mode=OneWay}" Foreground="{DynamicResource AppMuted}" FontSize="12"
                                                     TextTrimming="CharacterEllipsis" Margin="0,1,0,0"
                                                     Visibility="{Binding HasPreview, Converter={StaticResource B2V}}" />
                                <DockPanel Margin="0,3,0,0">
                                    <Border DockPanel.Dock="Right" CornerRadius="4" Padding="5,0" Background="{DynamicResource AppWarningSoft}"
                                            Visibility="{Binding HasBadge, Converter={StaticResource B2V}}">
                                        <TextBlock Text="{Binding ConflictBadge, Mode=OneWay}" FontSize="10" Foreground="{DynamicResource AppWarning}" />
                                    </Border>
                                    <TextBlock Text="{Binding TimeText, Mode=OneWay}" Style="{StaticResource Caption}" />
                                </DockPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="EmptyText" Grid.Row="1" Foreground="{DynamicResource AppMuted}" TextWrapping="Wrap" TextAlignment="Center"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12" Visibility="Collapsed" />
                <Button x:Name="MoreButton" Grid.Row="2" Content="{x:Static local:Strings.BtnNoteLoadMore}" Click="More_Click"
                        Margin="0,6,0,0" Visibility="Collapsed" />
            </Grid>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- the editor -->
            <Border Grid.Column="2" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="10"
                    Background="{DynamicResource AppSurface}" Padding="12">
                <views:NoteEditorPane x:Name="Editor" />
            </Border>
        </Grid>

        <TextBlock x:Name="SyncText" Grid.Row="3" Style="{StaticResource Caption}" Margin="2,8,0,0" TextTrimming="CharacterEllipsis" />
    </Grid>
</UserControl>
