<UserControl x:Class="ClipBridge.Windows.Views.VaultLockPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ClipBridge.Windows"
             xmlns:views="clr-namespace:ClipBridge.Windows.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
            <!-- Locked: the vault exists -->
            <StackPanel x:Name="UnlockPane" MaxWidth="480" HorizontalAlignment="Left" Margin="0,8,0,16" Visibility="Collapsed">
                <TextBlock Text="{x:Static local:Strings.LockedTitle}" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="{x:Static local:Strings.LockedHint}" Foreground="{DynamicResource AppMuted}" TextWrapping="Wrap" Margin="0,6,0,14" />
                <TextBlock x:Name="LockedNote" TextWrapping="Wrap" Foreground="{DynamicResource AppWarning}" Margin="0,0,0,10" Visibility="Collapsed" />
                <views:CredsBox x:Name="UnlockCreds" />
                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Button x:Name="UnlockButton" Content="{x:Static local:Strings.BtnUnlock}" MinWidth="110" Margin="0" Click="Unlock_Click" />
                    <TextBlock x:Name="UnlockStatus" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="320" />
                </StackPanel>
            </StackPanel>

            <!-- No vault yet -->
            <StackPanel x:Name="CreatePane" MaxWidth="520" HorizontalAlignment="Left" Margin="0,8,0,16" Visibility="Collapsed">
                <TextBlock Text="{x:Static local:Strings.CreateTitle}" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="{x:Static local:Strings.CreateIntro}" Foreground="{DynamicResource AppMuted}" TextWrapping="Wrap" Margin="0,6,0,12" />

                <Border Background="{DynamicResource AppDangerSoft}" BorderBrush="{DynamicResource AppDanger}" BorderThickness="2" CornerRadius="6" Padding="14,10" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="{x:Static local:Strings.CreateWarningTitle}" Foreground="{DynamicResource AppDanger}" FontSize="16" FontWeight="Bold" />
                        <TextBlock Text="{x:Static local:Strings.CreateWarningText}" Foreground="{DynamicResource AppDanger}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <views:CredsBox x:Name="CreateCreds" />
                <views:StrengthBar x:Name="CreateStrength" Margin="0,6,0,0" HorizontalAlignment="Left" />
                <TextBlock x:Name="CreateWeak" Text="{x:Static local:Strings.CreateWeakWarning}" Foreground="{DynamicResource AppWarning}" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed" />
                <views:CredsBox x:Name="CreateConfirm" Margin="0,12,0,0" />
                <TextBlock Text="{x:Static local:Strings.KeyFileRequiredNote}" Foreground="{DynamicResource AppMuted}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" />

                <Expander Header="{x:Static local:Strings.CreateAdvanced}" Margin="0,12,0,0">
                    <StackPanel Margin="0,8,0,0">
                        <TextBlock Text="{x:Static local:Strings.LabelKdf}" Margin="0,0,0,4" />
                        <ComboBox x:Name="KdfBox" Width="320" HorizontalAlignment="Left" SelectedValuePath="Tag">
                            <ComboBoxItem Tag="low" Content="{x:Static local:Strings.KdfLow}" />
                            <ComboBoxItem Tag="standard" Content="{x:Static local:Strings.KdfStandard}" IsSelected="True" />
                            <ComboBoxItem Tag="high" Content="{x:Static local:Strings.KdfHigh}" />
                        </ComboBox>
                    </StackPanel>
                </Expander>

                <TextBlock x:Name="CreateError" Foreground="{DynamicResource AppDanger}" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed" />
                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Button x:Name="CreateButton" Content="{x:Static local:Strings.BtnCreateVault}" MinWidth="130" Margin="0" Click="Create_Click" />
                    <TextBlock x:Name="CreateStatus" Margin="12,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
