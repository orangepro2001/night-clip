<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AssemblyName>ClipBridge</AssemblyName>
    <RootNamespace>ClipBridge.Windows</RootNamespace>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Stamped by `make dist-windows` (scripts/version.sh); a plain build is a dev build
       (code 0), which keeps self-update off. The update URL is deliberately not in the
       repository: it comes from the git-ignored release.local.env. -->
  <PropertyGroup>
    <CbVersionCode Condition="'$(CbVersionCode)' == ''">0</CbVersionCode>
    <CbVersionName Condition="'$(CbVersionName)' == ''">0.0.0-dev</CbVersionName>
    <CbUpdateUrl Condition="'$(CbUpdateUrl)' == ''"></CbUpdateUrl>
    <Version>$(CbVersionName)</Version>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>CbVersionCode</_Parameter1>
      <_Parameter2>$(CbVersionCode)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>CbVersionName</_Parameter1>
      <_Parameter2>$(CbVersionName)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>CbUpdateUrl</_Parameter1>
      <_Parameter2>$(CbUpdateUrl)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- clipbridge_core.dll is produced by `make dll` at the repository root. -->
  <PropertyGroup>
    <CoreDll>$(MSBuildThisFileDirectory)..\..\core\dist\windows-amd64\clipbridge_core.dll</CoreDll>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(CoreDll)')">
    <None Include="$(CoreDll)" Link="clipbridge_core.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="WarnMissingCoreDll" BeforeTargets="Build" Condition="!Exists('$(CoreDll)')">
    <Warning Text="clipbridge_core.dll not found at $(CoreDll). Run 'make dll' at the repository root; the app will fail to start without it." />
  </Target>

</Project>
