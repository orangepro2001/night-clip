# Copy to release.local.env (git-ignored) and adjust. Read by the Makefile and scripts/release-local.sh.
#
# Where installed apps look for updates (baked into every build) and where releases are uploaded.
# Since 2026-11-20 both are the public release-publish service on moon. The Makefile already
# defaults CB_UPDATE_URL to it; set it here only to build against another service.
CB_UPDATE_URL=https://release.moonl.cloud
RELHUB_URL=https://release.moonl.cloud

# A token that may only publish moonpassword, created on moon with
#   relhub app create -id moonpassword -name MoonPassword -data /var/lib/release-publish   (once)
#   relhub token create -name moonpassword-release -app moonpassword -data /var/lib/release-publish
# Keep this file private (chmod 600). Never commit it, never use the admin token here.
RELHUB_TOKEN=

# Optional overrides:
# RELHUB_BIN=$HOME/.local/bin/relhub
# MOONPASSWORD_SIGNING=$HOME/.config/moonpassword/android-signing.properties
# MOONPASSWORD_SIGNER_PIN=$HOME/.config/moonpassword/android-signer.sha256
