# Copy to release.local.env (git-ignored) and adjust. Read by the Makefile and scripts/release-local.sh.
#
# Where installed apps look for updates: the https URL that tailscale serve exposes for the
# release-publish service (its base URL, i.e. including the mount path). Baked into every build.
# Not committed because it names your tailnet.
CB_UPDATE_URL=https://your-machine.your-tailnet.ts.net/release

# Optional overrides:
# RELHUB_BIN=$HOME/.local/bin/relhub
# CLIPBRIDGE_SIGNING=$HOME/.config/clipbridge/android-signing.properties
# CLIPBRIDGE_SIGNER_PIN=$HOME/.config/clipbridge/android-signer.sha256
