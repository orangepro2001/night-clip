# Copy to release.local.env (git-ignored) and adjust. Read by the Makefile and scripts/release-local.sh.
#
# Where installed apps look for updates: the https URL that tailscale serve exposes for cbdist.
# Not committed because it names your tailnet.
CB_UPDATE_URL=https://your-machine.your-tailnet.ts.net/clipbridge

# Optional overrides:
# CLIPBRIDGE_RELEASES=$HOME/.local/share/clipbridge/releases
# CLIPBRIDGE_RELEASE_KEY=$HOME/.config/clipbridge/release-ed25519.key
# CLIPBRIDGE_SIGNING=$HOME/.config/clipbridge/android-signing.properties
