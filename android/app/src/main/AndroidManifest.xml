<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    >

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Real-time mode comes back after a reboot or an app update. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Scanning the pairing QR code; the app works without it (paste / manual input). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Optional battery-optimisation exemption dialog (onboarding / settings), never forced. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Lets the app hand its own downloaded update to the system package installer. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Saving received files to the public Downloads folder before Android 10 (MediaStore needs nothing on 10+). -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- Opt-in "background auto send" (docs/adr/006-android-background-read.md). READ_LOGS is a
         development permission: it can only be granted once from a computer with
         `adb shell pm grant com.nightclip.app android.permission.READ_LOGS`. It is used to watch
         ClipboardService denial lines, never to collect logs. Not allowed on Google Play. -->
    <uses-permission
        android:name="android.permission.READ_LOGS"
        tools:ignore="ProtectedPermissions" />
    <!-- Opt-in background read briefly takes window focus through a 1x1 overlay. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <queries>
        <!-- Only to offer an "open Tailscale" button during onboarding. -->
        <package android:name="com.tailscale.ipn" />
    </queries>

    <application
        android:name=".ClipBridgeApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ClipBridge">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- clipbridge://pair?… opened from a QR scanner or a chat: prefilled in the app, never joined automatically. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="clipbridge" android:host="pair" />
            </intent-filter>
        </activity>

        <!-- Share target: text goes to the clipboard channel, files go out as transfers. -->
        <activity
            android:name=".ShareActivity"
            android:exported="true"
            android:theme="@style/Theme.ClipBridge.Share">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- Invisible: reads the clipboard once it has focus (tile / notification action). Started only by our own PendingIntents. -->
        <activity
            android:name=".SendClipboardActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:taskAffinity=""
            android:theme="@style/Theme.ClipBridge.Transparent" />

        <!-- Invisible: writes a received text to the clipboard while it has focus (notification "复制"). -->
        <activity
            android:name=".CopyActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:taskAffinity=""
            android:theme="@style/Theme.ClipBridge.Transparent" />

        <!-- The library's scanner screen, allowed to follow the phone's orientation. -->
        <activity
            android:name=".PortraitCaptureActivity"
            android:exported="false"
            android:screenOrientation="fullSensor"
            android:stateNotNeeded="true"
            android:theme="@style/zxing_CaptureTheme"
            android:windowSoftInputMode="stateAlwaysHidden" />

        <!-- Autofill service (docs/plan-vault.md §7.1): the system binds it once the user picks ClipBridge as autofill service. -->
        <service
            android:name=".autofill.VaultAutofillService"
            android:exported="true"
            android:label="@string/autofill_service_label"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
            <meta-data
                android:name="android.autofill"
                android:resource="@xml/autofill_service_config" />
        </service>

        <!-- Opened by the system settings (gear next to the autofill service). Must be exported: the Settings app starts it. -->
        <activity
            android:name=".autofill.AutofillSettingsActivity"
            android:exported="true"
            android:label="@string/autofill_settings_title" />

        <!-- Transparent unlock / confirm screen the system launches from our own authentication IntentSender. -->
        <activity
            android:name=".autofill.AutofillAuthActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.ClipBridge.AutofillSheet"
            android:windowSoftInputMode="adjustResize" />

        <!-- "Save to vault" screen, started by the system (API 28+: from the save prompt) or by our service. -->
        <activity
            android:name=".autofill.AutofillSaveActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.ClipBridge.AutofillSheet"
            android:windowSoftInputMode="adjustResize" />

        <receiver
            android:name=".NotificationActionReceiver"
            android:exported="false" />

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".QuickSendTileService"
            android:exported="true"
            android:icon="@drawable/ic_stat_clip"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Shares the verified update APK with the package installer (res/xml/update_paths.xml). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_paths" />
        </provider>

        <!-- Keeps the process, the Go core and its outbound tailnet connection alive.
             specialUse (not dataSync): Android 15 caps dataSync foreground services
             at roughly 6 hours per day, which would break a persistent connection. -->
        <service
            android:name=".SyncForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps a direct peer connection to the user's paired devices over Tailscale to sync the clipboard and files" />
        </service>
    </application>
</manifest>
