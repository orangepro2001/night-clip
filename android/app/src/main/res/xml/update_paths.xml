<?xml version="1.0" encoding="utf-8"?>
<!-- What the app's FileProvider may share, and nothing else:
     - the update package: the Go core downloads it to <filesDir>/clipbridge/updates (CoreHost passes <filesDir>/clipbridge as data_dir);
     - notes attachments the user opens or shares: copies the app writes to <cacheDir>/notes-open/<attachment>/<name>;
     - photos taken with "take a photo and send": the camera app writes them to <cacheDir>/camera/<name>. -->
<paths>
    <files-path name="updates" path="clipbridge/updates/" />
    <cache-path name="notes_open" path="notes-open/" />
    <cache-path name="camera" path="camera/" />
</paths>
