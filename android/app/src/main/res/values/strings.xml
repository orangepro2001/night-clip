    <!-- Onboarding -->
    <string name="onboarding_title">欢迎使用 ClipBridge</string>
    <string name="onboarding_intro">在你自己的电脑和手机之间同步剪贴板、传文件。设备之间直连，不经过任何第三方服务器。</string>
    <string name="onboarding_tailscale_title">1. 需要 Tailscale</string>
    <string name="onboarding_tailscale_text">所有要同步的设备必须登录同一个 Tailscale 网络并保持连接。请先在手机上打开 Tailscale 并确认已连接。</string>
    <string name="onboarding_open_tailscale">打开 Tailscale</string>
    <string name="onboarding_notif_title">2. 通知权限</string>
    <string name="onboarding_notif_text">收到电脑发来的内容、文件请求和传输进度都通过通知提醒你。Android 13 及以上需要你允许通知。</string>
    <string name="onboarding_notif_button">允许通知</string>
    <string name="onboarding_granted">已允许</string>
    <string name="onboarding_battery_title">3. 电池优化（可选）</string>
    <string name="onboarding_battery_text">系统可能在后台停掉 ClipBridge。想随时收到内容，可以在设置里开启“实时模式”，并把本应用从电池优化中排除。不强制。</string>
    <string name="onboarding_battery_button">打开电池优化设置</string>
    <string name="onboarding_start">开始使用</string>

